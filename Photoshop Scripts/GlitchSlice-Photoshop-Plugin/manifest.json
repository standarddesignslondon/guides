{
    "id": "com.simonmorse.glitchslice",
    "name": "GlitchSlice",
    "version": "1.2.0",
    "main": "index.html",
    "manifestVersion": 5,
    "host": {
        "app": "PS",
        "minVersion": "24.2.0"
    },
    "entrypoints": [
        {
            "type": "panel",
            "id": "glitchslice.panel",
            "label": { "default": "GlitchSlice" },
            "minimumSize": { "width": 240, "height": 300 },
            "maximumSize": { "width": 600, "height": 2400 },
            "preferredDockedSize": { "width": 300, "height": 760 },
            "preferredFloatingSize": { "width": 300, "height": 760 }
        }
    ]
}
