{
    "id": "com.simonmorse.ditherpress",
    "name": "DitherPress",
    "version": "1.1.0",
    "main": "index.html",
    "manifestVersion": 5,
    "host": {
        "app": "PS",
        "minVersion": "24.2.0"
    },
    "entrypoints": [
        {
            "type": "panel",
            "id": "ditherpress.panel",
            "label": { "default": "DitherPress" },
            "minimumSize": { "width": 240, "height": 300 },
            "maximumSize": { "width": 600, "height": 2400 },
            "preferredDockedSize": { "width": 300, "height": 800 },
            "preferredFloatingSize": { "width": 300, "height": 800 }
        }
    ]
}
