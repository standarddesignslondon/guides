{
    "id": "com.simonmorse.signaldegrade",
    "name": "Signal Degrade",
    "version": "1.0.0",
    "main": "index.html",
    "manifestVersion": 5,
    "host": {
        "app": "PS",
        "minVersion": "24.2.0"
    },
    "entrypoints": [
        {
            "type": "panel",
            "id": "signaldegrade.panel",
            "label": { "default": "Signal Degrade" },
            "minimumSize": { "width": 240, "height": 300 },
            "maximumSize": { "width": 600, "height": 2400 },
            "preferredDockedSize": { "width": 300, "height": 720 },
            "preferredFloatingSize": { "width": 300, "height": 720 }
        }
    ]
}
